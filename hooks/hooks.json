{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/brainstorm-mode.sh",
            "statusMessage": "Checking brainstorm mode"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/approve-research.sh",
            "statusMessage": "Brainstorm research check"
          }
        ]
      }
    ]
  }
}
